# Ordinary tests, fake runs, dry runs, replay, and reports need no secrets or network.
# The live OpenAI adapter reads this variable only after both explicit live opt-ins.
# Never commit a real key or copy it into YAML, CLI arguments, logs, or run artifacts.
OPENAI_API_KEY=

# A live command additionally requires --allow-live-model. Key presence alone never spends.
WMS_ALLOW_LIVE_MODEL=0
